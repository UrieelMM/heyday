# URL pública: http://localhost:3000 en desarrollo; https://heyday.party en producción
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase > Project Settings > API Keys (claves nuevas)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Solo servidor. Nunca usar NEXT_PUBLIC_ ni guardar esta clave en Git.
SUPABASE_SECRET_KEY="sb_secret_..."

# Firma las sesiones de edición del cliente. Usa 32+ bytes aleatorios en producción.
EDITOR_SESSION_SECRET="reemplazar-con-un-secreto-aleatorio-largo"

# Secreto propio, aleatorio y distinto de las claves de Supabase (32+ bytes)
QR_MASTER_SECRET="reemplazar-con-un-secreto-aleatorio-largo"

# Correos de caducidad del álbum. RESEND_API_KEY debe ser solo de servidor.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="HeyDay <urieel.dev@gmail.com>"
# Destinatario temporal mientras se conecta el email real del cliente.
PHOTO_RETENTION_TEST_EMAIL="urieel.mm@gmail.com"

# Protege /api/cron/photo-retention. Vercel lo envía como Bearer token.
CRON_SECRET="reemplazar-con-un-secreto-aleatorio-largo"
